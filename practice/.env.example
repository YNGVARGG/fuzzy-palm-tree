# Copy to .env.local; keep secrets out of git and chat.
AUTH_URL=http://localhost:3001
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple requires a registered HTTPS domain, Services ID and signed client secret.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Optional absolute paths. Defaults resolve to ../agent.
# PRACTICE_AGENT_DIR=C:/path/to/agent
# PRACTICE_AUTH_MEMBERSHIPS_FILE=C:/private/auth-memberships.json
# Email links (preferred). Set privately in .env.local / deployment secrets.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Absolute path on persistent storage. Default: ../agent/email-auth.sqlite
# PRACTICE_AUTH_DB=

# n8n campaign simulation, scoped to one clinic. Store privately, never in workflow JSON.
# CAMPAIGN_WORKFLOW_TOKEN= (generate at least 32 random bytes)
# CAMPAIGN_WORKFLOW_TENANT=cabinet-dentaire-saint-michel
# PRACTICE_CAMPAIGN_DB= (persistent private path, defaults to ../agent/campaigns.sqlite)

# Local voice test server for the updated dental agent.
