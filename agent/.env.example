# Company Phone Agent — environment template
# Copy to .env and fill in your keys:  cp .env.example .env

# --- Tenant (which company the agent works for) ---
# The agent serves one company per call. When testing without telephony:
# TENANT_ID=french-demo
# When calls come in on real numbers, map dialed number -> tenant:
# TENANTS_PHONE_MAP=+33123456789:french-demo,+33698765432:other-tenant
TENANT_ID=french-demo

# --- LLM ---
# LLM_SERVICE: phonellm (default) | openai
#
# IMPORTANT: PhoneLLM Alpha 1 is English-only. For French-speaking tenants use
# LLM_SERVICE=openai with a multilingual model (gpt-4.1-mini by default).
# STT (Deepgram Flux) and TTS (Cartesia) handle French either way.
# LLM_SERVICE=openai

# PhoneLLM Alpha 1 behind any OpenAI-compatible endpoint (needs LLM_SERVICE=phonellm).
# Option A — Modal Auto Endpoint (official path):
#   modal endpoint create --model pipecat-ai/phonellm-alpha-1   (prints the URL)
#   modal workspace proxy-tokens create                          (prints token id + secret)
#   then LLM_API_KEY=<token-id>.<token-secret>
# Option B — local vLLM:
#   vllm serve pipecat-ai/phonellm-alpha-1 --max-model-len 4096 --port 8000
#   then LLM_BASE_URL=http://localhost:8000/v1 and LLM_API_KEY=anything
LLM_BASE_URL=
LLM_API_KEY=
# Optional: model id served by the endpoint (default: pipecat-ai/phonellm-alpha-1)
# PHONELLM_MODEL=pipecat-ai/phonellm-alpha-1

# LLM via any OpenAI-compatible endpoint (free options, no credit card):
#   Groq      https://api.groq.com/openai/v1      llama-3.3-70b-versatile (fastest)
#   Cerebras  https://api.cerebras.ai/v1          llama-3.3-70b
#   SambaNova https://api.sambanova.ai/v1         Llama-3.3-70B-Instruct
# Required when LLM_SERVICE=openai:
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- STT (Deepgram Flux is always used; multilingual incl. French) ---
DEEPGRAM_API_KEY=

# --- TTS ---
# TTS_SERVICE: cartesia (default) | deepgram
# TTS_SERVICE=cartesia
CARTESIA_API_KEY=
# Voice override. For French callers pick a French voice:
# - Cartesia: choose one from https://play.cartesia.ai (Sonic voices, e.g. "Fleur")
# - Deepgram Flux: e.g. flux-louise-fr (check Deepgram's voice list)
# TTS_VOICE=

# --- Telephony (only needed for -t twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Daily (only needed for -t daily) ---
# DAILY_API_KEY=
# DAILY_ROOM_URL=

# --- VPS deployment (only needed when running on the VPS) ---
# Free tunnel for Twilio wss:// — from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=

# --- Business logging ---
# Where appointments and messages are appended (JSONL). Default: call-activity.jsonl
# BUSINESS_LOG_FILE=call-activity.jsonl